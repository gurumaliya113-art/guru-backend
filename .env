# ⭐ KEY POOL — paste ALL your Gemini keys here, comma-separated (no spaces).
# The server rotates through them automatically: when one key's daily quota
# runs out (429), it is parked for a while and the next key takes over. Add as
# many as you like (10+). This is the recommended way to keep AI Pro Max running
# every day without manual key swapping.
GEMINI_API_KEYS=AQ.Ab8RN6IqHw41L9QAcHXcvTfxD-PhSLQGviiZUL8YBaQCPU3nvg,AQ.Ab8RN6K8ymwenAgFYbxyFqGXu7pMgAcTOWsr_mvUfSHpIENEWQ,,AQ.Ab8RN6LLyqtQcXitahCpqA27Fo8s3vxGzhbw8VNFcQICrwai5w,AQ.Ab8RN6L6LRnScMb2KDdKuIw6RHv0qONipI4n_T2JX5II1Xn6uA,AQ.Ab8RN6Kk-wnWP9cab7UtT82nV_DBqM60CA_jKl1Gdb1oppK0Bw,AQ.Ab8RN6IX7DJ0e7vSr6pc0ogFzMWoeymaXw9ch-C-3wRTUPcvXA,AQ.Ab8RN6K4fwlGGkUo8jQCCidvMvTKWJd8M3mMUNiDcUquxAUQKw,AQ.Ab8RN6J2UK93Vs1AjxFetvqVkc1eOLsb7zTgi0ZHZLXQKkGMyQ
# How long a key stays parked after a 429 (ms). Default 30 min. It rejoins the
# pool automatically after this, so quota resets bring keys back on their own.
GEMINI_KEY_COOLDOWN_MS=60000
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DPP_MODEL=gemini-2.5-flash
GEMINI_DPP_CHAT_MODEL=gemini-2.5-flash

# --- PDF parse time/page limits (realtime progress feature) ---
# PARSE_TIME_BUDGET_MS: overall wall-clock budget for one upload. Parsing now
#   runs in the BACKGROUND (the POST returns immediately), so the hosting
#   gateway's ~60s request timeout no longer applies — a big PDF can take
#   minutes without any 502. 15 min is plenty for large papers.
PARSE_TIME_BUDGET_MS=900000
# DPP_VISION_PAGE_CAP: max pages the scanned/vision path will read per upload.
#   Raised so scanned PDFs also process more pages within the time budget.
DPP_VISION_PAGE_CAP=40

